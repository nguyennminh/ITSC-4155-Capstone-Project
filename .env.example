# Required for npm run server and npm start. Use a development database locally.
MONGODB_URI=
DB_NAME=jobswipe

# Optional
JOB_PROVIDER=greenhouse
# Run npm run model:prepare before starting MiniLM locally.
MATCHING_MODE=minilm
# Set keyword to disable the model worker on a resource-constrained instance.
# MINILM_MODEL_DIR=/absolute/path/to/prepared/model
# GREENHOUSE_BOARDS=discord,cloudflare,figma,robinhood
# GEMINI_API_KEY=
# GOOGLE_CLIENT_ID=
